{
  "manifest_version": 3,
  "name": "AI 新闻工作台 · 小黑盒填入助手",
  "version": "0.1.17",
  "description": "把本地 AI 新闻工作台中的文章或图文草稿填入常用 Chrome 里的小黑盒编辑器；不会点击最终发布。",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting"],
  "action": {
    "default_title": "小黑盒填入助手",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "http://127.0.0.1:4317/*",
    "https://xiaoheihe.cn/*",
    "https://*.xiaoheihe.cn/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:4317/*"],
      "js": ["app-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://xiaoheihe.cn/*", "https://*.xiaoheihe.cn/*"],
      "js": ["xiaoheihe-dom.js", "xiaoheihe-image-post-dom.js", "xiaoheihe.js"],
      "run_at": "document_idle"
    }
  ]
}
