{
  "name": "ai-news-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.16 <23",
    "npm": ">=10.9 <11"
  },
  "scripts": {
    "dev": "tsx server/start.ts",
    "build": "tsc --noEmit && vite build",
    "start": "cross-env NODE_ENV=production tsx server/start.ts",
    "test": "node --test --import tsx server/**/*.test.ts src/**/*.test.ts src/**/*.test.tsx chrome-extension/**/*.test.ts",
    "test:e2e": "node --test --test-force-exit --import tsx tests/e2e/*.test.ts",
    "eval:editorial": "tsx server/editorial-golden-cli.ts",
    "eval:discovery": "tsx server/news-discovery-golden.ts",
    "eval:extraction": "tsx server/article-extraction-golden.ts",
    "eval:integrity": "tsx server/evidence-integrity-golden.ts"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "6.0.5",
    "ajv": "8.20.0",
    "cheerio": "1.2.0",
    "express": "5.2.1",
    "lucide-react": "1.31.0",
    "playwright-core": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.2",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.3",
    "simple-icons": "^16.28.0",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "cross-env": "^10.1.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
